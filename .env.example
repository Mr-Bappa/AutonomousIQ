# Copy to .env and fill in real values for local dev. Never commit .env.

# Required always
DATABASE_URL=postgresql+asyncpg://autonomousiq:autonomousiq@localhost:5432/autonomousiq
JWT_SECRET=change-me-to-a-random-64-char-string
SESSION_SECRET=change-me-to-a-different-random-string

# OAuth providers -- Baseline supports all three; leave a pair blank to
# disable that provider (register_configured_providers() skips it).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# Comma-separated list of origins allowed to call the API from a
# browser. Defaults to the Vite dev server if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the Formula.js sidecar (services/formula-sidecar).
# docker-compose overrides this to the internal service DNS name.
FORMULA_SIDECAR_URL=http://localhost:8801

# --- LLM provider (D-10) ---------------------------------------------
# "naive" (default) needs nothing and runs a keyword-based demo planner.
# "vertex" calls real Vertex AI/Gemini and needs the GCP vars below.
LLM_PROVIDER=naive

# --- GCP integration ---------------------------------------------------
# Leave GCP_PROJECT_ID blank to skip GCP entirely: Documents fall back to
# local-disk storage (/tmp) and LLM_PROVIDER should stay "naive".
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_BUCKET=
VERTEX_MODEL=gemini-1.5-flash
# Local dev only -- unset (unused) on Cloud Run/GKE, which use the
# attached service account's Application Default Credentials instead.
GOOGLE_APPLICATION_CREDENTIALS=
